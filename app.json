{
  "expo": {
    "name": "AmisSindh",
    "slug": "AmisSindh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/swat-app-icon-android.png",
    "scheme": "amissindh",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/swat-app-icon-ios.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/swat-app-icon-android.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aali_edward.AmisSindh",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/swat-splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2e7d32",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "The SWAT AMIS App needs access your photos to to upload the record of the commodities.",
          "colors": {
            "cropToolabrColor": "#ffffff"
          },
          "cameraPermission": "The SWAT AMIS App needs access your camera to take the picture of the commodities.",
          "microPhonePermission": "The SWAT AMIS App needs access your microphone to record the voice note of the commodities."
        }
      ],
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "54f36e13-668a-45cc-910a-38a7f378e596"
      }
    },
    "owner": "aali_edward"
  }
}
